{
  "schemaVersion": 1,
  "id": "liquidbounce-droidbridge",
  "version": "${version}",
  "name": "LiquidBounce DroidBridge",
  "description": "Shows the client's interface with the web view of Android, drawn on top of the game.",
  "authors": [
    "lovelisy",
    "Cleverpeople622"
  ],
  "contact": {
    "homepage": "https://liquidbounce.net/",
    "sources": "https://github.com/lovelisy/LiquidBounce-Addon-DroidBridge",
    "issues": "https://github.com/lovelisy/LiquidBounce-Addon-DroidBridge/issues"
  },
  "license": "GPL-3.0-or-later",
  "environment": "client",
  "entrypoints": {
    "liquidbounce": [
      "liquidbounce.DroidBridge.Addon"
    ]
  },
  "accessWidener": "liquidbounce-droidbridge.accesswidener",
  "mixins": [
    "droidbridge.mixins.json"
  ],
  "depends": {
    "minecraft": "~${minecraft_version}",
    "fabricloader": ">=${loader_version}",
    "fabric-language-kotlin": ">=${fabric_kotlin_version}",
    "liquidbounce": "*"
  },
  "custom": {
    "liquidbounce": {
      "color": "#24C8DB"
    },
    "modmenu": {
      "parent": "liquidbounce"
    }
  }
}
