{
  "schemaVersion": 1,
  "id": "liquidbounce-wry",
  "version": "${version}",
  "name": "LiquidBounce Wry",
  "description": "Lets you show the client's menus with the web view built into your system, through Wry, instead of the built-in Chromium.",
  "authors": [
    "CCBlueX"
  ],
  "contact": {
    "homepage": "https://liquidbounce.net/",
    "sources": "https://github.com/CCBlueX/LiquidBounce-Addon-Wry",
    "issues": "https://github.com/CCBlueX/LiquidBounce-Addon-Wry/issues"
  },
  "license": "GPL-3.0-or-later",
  "environment": "client",
  "entrypoints": {
    "liquidbounce": [
      "net.ccbluex.liquidbounce.wry.WryAddon"
    ]
  },
  "accessWidener": "liquidbounce-wry.accesswidener",
  "depends": {
    "minecraft": "~${minecraft_version}",
    "fabricloader": ">=${loader_version}",
    "fabric-language-kotlin": ">=${fabric_kotlin_version}",
    "liquidbounce": "*"
  },
  "custom": {
    "liquidbounce": {
      "color": "#24C8DB"
    },
    "modmenu": {
      "parent": "liquidbounce"
    }
  }
}
