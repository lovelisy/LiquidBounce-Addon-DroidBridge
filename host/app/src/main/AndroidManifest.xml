<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- targetSdk 34 起，specialUse 类型的前台服务必须显式申请此权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".McefPluginApplication"
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:zygotePreloadName="org.chromium.content_public.app.ZygotePreload">

        <!-- 主入口：miuix 设置/状态页 -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- MCEF host：监听从 MC 侧 libmcef.so 连来的 IPC。
             与启动器里那份等价，只是宿主换成了本插件。 -->
        <service
            android:name=".cef.CefriumHostService"
            android:process="liquidbounce.droidbridge.host.cefhost"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="MCEF browser host" />
        </service>

        <!-- 给 CEF 初始化提供 Window 上下文（Service 里没有 ViewRootImpl，
             直接 init 会 SIGSEGV） -->
        <activity
            android:name=".cef.CefriumHostActivity"
            android:process="liquidbounce.droidbridge.host.cefhost"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout" />

        <!-- 禁用 AAR 的零配置 provider：它会在本进程初始化并加载 so。
             初始化由 CefriumHostService 在 :cefhost 显式完成。 -->
        <provider
            android:name="com.cefrium.CefriumInitProvider"
            android:authorities="${applicationId}.cefriuminit"
            android:exported="false"
            tools:node="remove" />

        <!-- NativeLibPlugin 协议标记：让启动器把本插件的 lib 目录
             加进 MC JVM 的 LD_LIBRARY_PATH（libmcef.so 从这里加载）。 -->
        <meta-data
            android:name="FCLNativePlugin"
            android:value="true" />
        <meta-data
            android:name="des"
            android:value="MCEF 内置浏览器引擎（Cefrium 0.19.0）" />
        <!-- environment 必须存在且非 null，空串合法 -->
        <meta-data
            android:name="environment"
            android:value="" />
        <meta-data
            android:name="minMCVer"
            android:value="" />
        <meta-data
            android:name="maxMCVer"
            android:value="" />

    </application>

</manifest>
